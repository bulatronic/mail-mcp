{
    "name": "mail-mcp/mail-mcp",
    "description": "MCP server for reading Mail.ru mailbox and preparing draft replies",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "directorytree/imapengine": "^1.25",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/finder": "^7.3 || ^8.0",
        "symfony/mime": "^7.3 || ^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MailMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailMcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "php-cs-fixer check --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --cache-file=/tmp/mail-mcp-deptrac.cache",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    }
}
